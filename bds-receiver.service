[Unit]
Description=HERMES BDS Receiver API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/zalobot
EnvironmentFile=/root/bds-crawler/.env
ExecStart=/usr/bin/python3.11 -m uvicorn receiver:app --host 0.0.0.0 --port 8082 --workers 1 --no-access-log
Restart=always
RestartSec=5
MemoryMax=120M

[Install]
WantedBy=multi-user.target